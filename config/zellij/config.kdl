// Zellij configuration

theme "onedark-bright-select"

themes {
    onedark-bright-select {
        fg "#dcdfe4"
        bg "#3e4452"
        black "#282c34"
        red "#e06c75"
        green "#98c379"
        yellow "#e5c07b"
        blue "#61afef"
        magenta "#c678dd"
        cyan "#56b6c2"
        white "#ffffff"
        orange "#d19a66"
    }
}

// Clean UI
pane_frames false
default_layout "compact"
show_startup_tips false

// Editor for scrollback
scrollback_editor "micro"

// Mouse support
mouse_mode true

// Copy behavior
copy_on_select true

// Scrollback
scroll_buffer_size 10000

// Session management
session_serialization true
serialize_pane_viewport true

// Web server: bind to all interfaces so IAP TCP forwarding can reach it
// on the VM's primary interface. Access control is enforced by the GCP
// firewall rule (source 35.235.240.0/20 -> tcp:8082). Port pinned so the
// IAP bootstrap script and firewall rule stay in sync.
web_server_ip "0.0.0.0"
web_server_port 8082

// Background plugins
load_plugins {
    "file:~/.config/zellij/plugins/dim-unfocused.wasm" {
        fg "#dcdfe4"
        bg "#282c34"
        dim "0.4"
    }
}

keybinds clear-defaults=true {
    // Ctrl+Shift = Zellij workspace, Ctrl = shell/apps
    // Caps lock mapped to ctrl for ergo

    shared_except "locked" {
        // Session/mode
        bind "Ctrl Shift g" { SwitchToMode "locked"; }
        bind "Ctrl Shift q" { Detach; }

        // Panes
        bind "Ctrl Shift n" { NewPane; }
        bind "Ctrl Shift w" { CloseFocus; }
        bind "Ctrl Shift h" { MoveFocus "Left"; }
        bind "Ctrl Shift j" { MoveFocus "Down"; }
        bind "Ctrl Shift k" { MoveFocus "Up"; }
        bind "Ctrl Shift l" { MoveFocus "Right"; }
        bind "Ctrl Shift =" { Resize "Increase"; }
        bind "Ctrl Shift -" { Resize "Decrease"; }
        bind "Ctrl Shift z" { ToggleFocusFullscreen; }

        // Tabs
        bind "Ctrl Shift t" { NewTab; }
        bind "Ctrl Shift 1" { GoToTab 1; }
        bind "Ctrl Shift 2" { GoToTab 2; }
        bind "Ctrl Shift 3" { GoToTab 3; }
        bind "Ctrl Shift 4" { GoToTab 4; }
        bind "Ctrl Shift 5" { GoToTab 5; }
        bind "Ctrl Shift [" { GoToPreviousTab; }
        bind "Ctrl Shift ]" { GoToNextTab; }

        // Scroll
        bind "Ctrl Shift s" { SwitchToMode "scroll"; }

        // Session picker
        bind "Ctrl Shift o" { Run "session-picker" { floating true; close_on_exit true; skip_confirm true; }; }

        // Command palette
        bind "Ctrl Shift p" { Run "command-palette" { floating true; close_on_exit true; skip_confirm true; }; }

        // Keybindings + env help
        bind "Ctrl Shift /" { Run "keybinds-help" { floating true; close_on_exit true; skip_confirm true; }; }

        // Layouts
        bind "Ctrl Shift Space" { NextSwapLayout; }
    }

    locked {
        bind "Ctrl Shift g" { SwitchToMode "normal"; }
    }

    scroll {
        bind "Ctrl Shift s" { SwitchToMode "normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "Esc" { SwitchToMode "normal"; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
    }

    entersearch {
        bind "Enter" { SwitchToMode "search"; }
        bind "Esc" { SwitchToMode "scroll"; }
    }

    search {
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "Esc" { SwitchToMode "scroll"; }
    }
}
