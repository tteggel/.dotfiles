// Zellij configuration

theme "onedark-bright-select"

themes {
    onedark-bright-select {
        fg "#dcdfe4"
        bg "#3e4452"
        black "#282c34"
        red "#e06c75"
        green "#98c379"
        yellow "#e5c07b"
        blue "#61afef"
        magenta "#c678dd"
        cyan "#56b6c2"
        white "#ffffff"
        orange "#d19a66"
    }
}

// Clean UI
pane_frames false
default_layout "compact"
show_startup_tips false

// Editor for scrollback
scrollback_editor "micro"

// Mouse support
mouse_mode true

// Copy behavior
copy_on_select true
copy_command "clip.exe"

// Scrollback
scroll_buffer_size 10000

// Session management
session_serialization true
serialize_pane_viewport true

keybinds clear-defaults=true {
    // Ctrl-based bindings — user has caps lock mapped to ctrl for ergo

    shared_except "locked" {
        // Session/mode
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl q" { Detach; }

        // Panes
        bind "Ctrl n" { NewPane; }
        bind "Ctrl d" { CloseFocus; }
        bind "Ctrl h" { MoveFocus "Left"; }
        bind "Ctrl j" { MoveFocus "Down"; }
        bind "Ctrl k" { MoveFocus "Up"; }
        bind "Ctrl l" { MoveFocus "Right"; }
        bind "Ctrl =" { Resize "Increase"; }
        bind "Ctrl -" { Resize "Decrease"; }

        // Tabs
        bind "Ctrl t" { NewTab; }
        bind "Ctrl 1" { GoToTab 1; }
        bind "Ctrl 2" { GoToTab 2; }
        bind "Ctrl 3" { GoToTab 3; }
        bind "Ctrl 4" { GoToTab 4; }
        bind "Ctrl 5" { GoToTab 5; }
        bind "Ctrl [" { GoToPreviousTab; }
        bind "Ctrl ]" { GoToNextTab; }

        // Scroll
        bind "Ctrl s" { SwitchToMode "scroll"; }

        // Command palette
        bind "Ctrl p" { Run "command-palette" { floating true; }; }

        // Layouts
        bind "Ctrl Space" { NextSwapLayout; }
    }

    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }

    scroll {
        bind "Ctrl s" { SwitchToMode "normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "Esc" { SwitchToMode "normal"; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
    }

    entersearch {
        bind "Enter" { SwitchToMode "search"; }
        bind "Esc" { SwitchToMode "scroll"; }
    }

    search {
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "Esc" { SwitchToMode "scroll"; }
    }
}
