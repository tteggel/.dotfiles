layout {
    pane split_direction="vertical" {
        pane stacked=true size="50%" {
            pane command="claude" name="Claude" {
                args "--resume"
            }
            pane command="gemini" name="Gemini" {
                args "--resume" "latest" "--model" "gemini-3.1-pro"
            }
        }
        pane stacked=true size="50%" {
            pane command="lazygit" name="Git"
            pane name="Terminal"
        }
    }
}
