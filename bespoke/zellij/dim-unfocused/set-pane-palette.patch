+/// Override entries in the pane's 256-color palette.
+/// Each entry is (color_index, Some((r,g,b))) to set or (color_index, None) to reset.
+pub fn set_pane_palette(pane_id: PaneId, overrides: Vec<(u8, Option<(u8, u8, u8)>)>) {
+    let plugin_command = PluginCommand::SetPanePalette(pane_id, overrides);
+    let protobuf_plugin_command: ProtobufPluginCommand = plugin_command.try_into().unwrap();
+    object_to_stdout(&protobuf_plugin_command.encode_to_vec());
+    unsafe { host_run_plugin_command() };
+}
