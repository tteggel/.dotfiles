SizingCrop` or `imageSizingContain` instead of PptxGenJS built-in image sizing.\n42:- For charts or diagrams that PptxGenJS cannot express well, render SVG externally and place the SVG in the slide.\n71:Load `references/pptxgenjs-helpers.md` if you need the helper API summary or dependency details.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"9dd5f4e3-89fd-4236-a473-db98053b1022","context":{"git_state":{"cwd":"/home/thom/src/github.com/tteggel/.dotfiles","root":"/home/thom/src/github.com/tteggel/.dotfiles","branch":"master","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"tteggel/.dotfiles","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"tteggel/.dotfiles","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"tteggel/.dotfiles","visibility":"public"}]}},"live_cwd":"/home/thom/src/github.com/tteggel/.dotfiles","platform":"wsl"}},"sourceToolAssistantUUID":"dfca078e-168b-40f7-822b-b4895c4e1192","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"ff4c36dc-31b6-4ffc-a570-c7ff2f63f5ce","userType":"external","entrypoint":"cli","cwd":"/home/thom/src/github.com/tteggel/.dotfiles","sessionId":"5177785d-cd1e-4fc5-a113-5f63d7df1406","version":"2.1.302","gitBranch":"master"}
