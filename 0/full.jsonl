x-direnv keeps the previous devshell when evaluation fails, e.g. in\n  # Codex's sandbox, which can't reach the nix daemon.\n  if [ -n \"''${NIX_DIRENV_DID_FALLBACK-}\" ]; then\n    echo \"direnv: couldn't re-evaluate this project's devshell, so this command has the previous one. Run \\`direnv exec . true\\` outside the sandbox to rebuild it or see the error.\" >&2\n  fi\n''\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"060262dd-55a4-4772-a242-082ad2e1a03c","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"ff4c36dc-31b6-4ffc-a570-c7ff2f63f5ce","userType":"external","entrypoint":"cli","cwd":"/home/thom/src/github.com/tteggel/.dotfiles","sessionId":"5177785d-cd1e-4fc5-a113-5f63d7df1406","version":"2.1.302","gitBranch":"master"}
